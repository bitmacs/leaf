#version 460 core
#extension GL_EXT_ray_query : require
#extension GL_EXT_ray_tracing_position_fetch : require

#include "types.glsl"

// Monte Carlo 路径追踪参数
#define MAX_DEPTH 3                    // 最大路径深度（bounce次数）
#define SAMPLES_PER_ITERATION 1        // 每帧每像素采样次数（渐进式渲染：每帧累积少量样本）

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform CameraBuffer {
    Camera cameras[2];
};

layout(set = 0, binding = 2) uniform accelerationStructureEXT top_level_as;

layout(set = 0, binding = 3, std140) uniform DirectionalLight {
    vec3 direction; // 太阳光方向（从太阳指向场景，归一化）
} light;

layout(set = 0, binding = 4, rgba8) uniform restrict writeonly image2D output_image;
layout(set = 0, binding = 5, rgba32f) uniform restrict writeonly image2D gbuffer_position_image;
layout(set = 0, binding = 6, rgba32f) uniform restrict writeonly image2D gbuffer_normal_image;
layout(set = 0, binding = 7, rgba8) uniform restrict writeonly image2D gbuffer_albedo_image;
layout(set = 0, binding = 8, r32f) uniform restrict writeonly image2D gbuffer_depth_image;
layout(set = 0, binding = 9, rgba32f) uniform restrict writeonly image2D direct_radiance_image;
layout(set = 0, binding = 10, rgba32f) uniform restrict writeonly image2D indirect_radiance_image;

layout(push_constant) uniform PathTracingPushConstants {
    uint camera_index;
    uint iteration;  // 渐进式渲染的全局迭代次数（用于生成不同的随机种子）
} pc;

// ========== 太阳光（面积光）参数 ==========
// 太阳作为虚拟球体光源的物理参数
#define SUN_DISTANCE 10000.0           // 太阳虚拟距离（足够远可视为无限）
// 太阳角半径：真实值约 0.00465 弧度 (0.267°)
// 增大此值可获得更柔和的阴影和更高的采样效率（艺术化调整）
const float SUN_ANGULAR_RADIUS = 0.05; // 增大到 2.86°

const float SOLID_ANGLE_SUN = 2.0 * PI * (1.0 - cos(SUN_ANGULAR_RADIUS));

// 太阳光辐亮度 L_sun
// 物理值：真实太阳辐亮度约 20,000,000 W/(m²·sr) ≈ 20 MW/(m²·sr)
// 这里的值是经过归一化缩放的渲染值，结合曝光后产生合理的视觉亮度
// RGB 值遵循 D65 标准白点光谱，色温约 6500K
const vec3 SUN_INTENSITY = vec3(160.0, 157.0, 152.0);

// 光线命中信息
struct RayHit {
    bool hit;
    float t;
    vec3 position;
    vec3 normal;
    vec3 albedo;
};

// 生成二维随机数
vec2 random2(uint seed) {
    return vec2(
        random(seed),
        random(seed + 1u)
    );
}

// 在单位圆盘上均匀采样
vec2 sampleDisk(vec2 u) {
    float r = sqrt(u.x);
    float theta = TWO_PI * u.y;
    return vec2(r * cos(theta), r * sin(theta));
}

// 在单位半球上余弦加权采样
vec3 sampleCosineHemisphere(vec2 u, vec3 normal) {
    vec2 disk = sampleDisk(u);
    float z = sqrt(max(0.0, 1.0 - disk.x * disk.x - disk.y * disk.y));

    vec3 tangent = normalize(cross(normal, abs(normal.x) > 0.9 ? vec3(0, 1, 0) : vec3(1, 0, 0)));
    vec3 bitangent = cross(normal, tangent);

    return normalize(tangent * disk.x + bitangent * disk.y + normal * z);
}

// ========== MIS（power heuristic）辅助函数 ==========

// 余弦加权半球采样的 PDF
float cosineHemispherePDF(vec3 normal, vec3 direction) {
    float cos_theta = max(dot(normal, direction), 0.0);
    return cos_theta * ONE_OVER_PI;
}

// 太阳圆盘采样的 PDF（均匀分布在圆盘上）
// p(ω) = 1 / Ω，其中 Ω 是太阳的立体角
float sunDiskPDF() {
    return 1.0 / SOLID_ANGLE_SUN;
}

// 检查方向是否在太阳圆盘内
// 通过比较点积与角半径的余弦值来判断（避免高昂的 acos 计算）
bool isDirectionInSunDisk(vec3 direction, vec3 sun_dir) {
    float cos_angle = max(dot(direction, sun_dir), 0.0);
    float cos_angular_radius = cos(SUN_ANGULAR_RADIUS);
    return cos_angle > cos_angular_radius;
}

// Power heuristic: w_f = p_f^β / (p_f^β + p_g^β)，取 β=2
float powerHeuristic(float p_f, float p_g) {
    float p_f2 = p_f * p_f;
    float p_g2 = p_g * p_g;
    return p_f2 / (p_f2 + p_g2);
}

RayHit traceRay(vec3 origin, vec3 direction, float t_min, float t_max) {
    RayHit hit;
    hit.hit = false;
    hit.t = t_max;

    rayQueryEXT ray_query;
    rayQueryInitializeEXT(ray_query,
                          top_level_as,
                          gl_RayFlagsOpaqueEXT,
                          0xFF,
                          origin,
                          t_min,
                          direction,
                          t_max);

    while(rayQueryProceedEXT(ray_query)) {
    }

    if (rayQueryGetIntersectionTypeEXT(ray_query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        hit.hit = true;
        hit.t = rayQueryGetIntersectionTEXT(ray_query, true);
        hit.position = origin + direction * hit.t;

        vec3 triangle_vertices[3];
        rayQueryGetIntersectionTriangleVertexPositionsEXT(ray_query, true, triangle_vertices);

        vec3 edge1 = triangle_vertices[1] - triangle_vertices[0];
        vec3 edge2 = triangle_vertices[2] - triangle_vertices[0];
        vec3 object_normal = normalize(cross(edge1, edge2));

        mat4x3 world_to_object = rayQueryGetIntersectionWorldToObjectEXT(ray_query, true);
        hit.normal = normalize(transpose(mat3(
            world_to_object[0].xyz,
            world_to_object[1].xyz,
            world_to_object[2].xyz
        )) * object_normal);

        if (dot(hit.normal, normalize(direction)) > 0.0) {
            hit.normal = -hit.normal;
        }

        uint entity_id = rayQueryGetIntersectionInstanceCustomIndexEXT(ray_query, true);
        if (entity_id == 1) hit.albedo = vec3(1.0, 0.0, 0.0);
        else if (entity_id == 2) hit.albedo = vec3(0.5);
        else if (entity_id == 3) hit.albedo = vec3(0.0, 0.0, 1.0);
        else if (entity_id == 4) hit.albedo = vec3(1.0, 1.0, 0.0);
        else if (entity_id == 5) hit.albedo = vec3(1.0, 0.0, 0.0);  // 红色左侧墙（Cornell box风格）
        else hit.albedo = vec3(0.5);
    }

    return hit;
}

// ========== 太阳圆盘（面积光）实现 ==========

// 构建太阳圆盘的局部坐标系
void buildSunCoordinateSystem(vec3 sun_dir, out vec3 sun_x, out vec3 sun_y) {
    sun_x = normalize(cross(sun_dir, abs(sun_dir.x) < 0.9 ? vec3(1,0,0) : vec3(0,1,0)));
    sun_y = cross(sun_x, sun_dir);
}

// 从太阳立体角内均匀采样一个方向（NEE - Light Sampling）
// 这是 MIS（power heuristic）的光源采样分支：直接在方向域采样太阳的立体角
// 使用圆锥内均匀采样（uniform conical sampling in solid angle）
vec3 sampleSunDiskDirection(vec2 u) {
    vec3 sun_dir = -light.direction;  // light.direction 在 CPU 端已归一化

    // 在圆锥内均匀采样（solid angle 域均匀采样）
    // PDF = 1 / Ω_sun = 1 / [2π(1 - cos(θ_max))]
    // 采样方法：cos_theta 从 [cos(θ_max), 1] 线性采样
    float cos_max = cos(SUN_ANGULAR_RADIUS);
    float cos_theta_sun = mix(cos_max, 1.0, u.x);

    float sin_theta = sqrt(1.0 - cos_theta_sun * cos_theta_sun);
    float phi = TWO_PI * u.y;

    // 构建太阳局部坐标系
    vec3 sun_x, sun_y;
    buildSunCoordinateSystem(sun_dir, sun_x, sun_y);

    // 转换到世界空间（归一化因为浮点误差）
    vec3 sampled_dir = normalize(
        sin_theta * cos(phi) * sun_x +
        sin_theta * sin(phi) * sun_y +
        cos_theta_sun * sun_dir
    );

    return sampled_dir;
}

// 评估太阳光的辐射度（太阳不是点光源，而是一个有面积的发光圆盘）
// 评估太阳光的辐亮度 Le(ω) = L_sun * V(x, ω)，其中 V 是可见性函数
vec3 evaluateSunRadiance(vec3 direction) {
    vec3 sun_dir = -light.direction;  // light.direction 在 CPU 端已归一化

    if (isDirectionInSunDisk(direction, sun_dir)) {
        return SUN_INTENSITY;
    }
    return vec3(0.0);
}

vec3 evaluateSkyRadiance(vec3 direction) {
    return vec3(0.5, 0.7, 1.0) * 0.05;
}

// ========== 标准路径追踪：单采样 + NEE ==========

vec3 pathTrace(vec3 origin, vec3 direction, uint pixel_seed) {
    vec3 throughput = vec3(1.0);
    vec3 radiance = vec3(0.0);

    for (int depth = 0; depth < MAX_DEPTH; ++depth) {
        uint seed = pixel_seed + uint(depth) * 1000u;

        RayHit hit = traceRay(origin, direction, EPSILON, 100000.0);

        if (!hit.hit) {
            vec3 L_sun = evaluateSunRadiance(direction);
            vec3 L_sky = evaluateSkyRadiance(direction);
            radiance += throughput * (L_sun + L_sky);
            break;
        }

        // ========== NEE（Next Event Estimation）- 光源采样 ==========
        vec2 u_sun = random2(seed + 100u);
        vec3 sun_dir = sampleSunDiskDirection(u_sun);
        float pdf_sun = sunDiskPDF();
        float NdotL_sun = max(dot(hit.normal, sun_dir), 0.0);

        if (NdotL_sun > 0.0 && pdf_sun > 0.0) {
            vec3 shadow_origin = hit.position + hit.normal * EPSILON;
            RayHit shadow_hit = traceRay(shadow_origin, sun_dir, EPSILON, 100000.0);

            bool sun_visible = !shadow_hit.hit;

            if (sun_visible) {
                vec3 L_sun = SUN_INTENSITY;
                float pdf_bsdf = cosineHemispherePDF(hit.normal, sun_dir);
                float mis_weight = powerHeuristic(pdf_sun, pdf_bsdf);

                vec3 brdf = hit.albedo * ONE_OVER_PI;
                radiance += throughput * brdf * L_sun * NdotL_sun / pdf_sun * mis_weight;
            }
        }

        // ========== BSDF 采样 - 路径继续 ==========
        vec2 u_bsdf = random2(seed + 200u);
        vec3 bsdf_dir = sampleCosineHemisphere(u_bsdf, hit.normal);
        float pdf_bsdf = cosineHemispherePDF(hit.normal, bsdf_dir);
        float NdotL_bsdf = max(dot(hit.normal, bsdf_dir), 0.0);

        if (NdotL_bsdf <= 0.0 || pdf_bsdf <= 0.0) {
            break;
        }

        // 追踪 BSDF 光线，检查是否直接击中光源
        vec3 bsdf_origin = hit.position + hit.normal * EPSILON;
        RayHit bsdf_hit = traceRay(bsdf_origin, bsdf_dir, EPSILON, 100000.0);

        if (!bsdf_hit.hit) {
            vec3 L_sun = evaluateSunRadiance(bsdf_dir);
            vec3 L_sky = evaluateSkyRadiance(bsdf_dir);
            if (length(L_sun) > 0.0) {
                float pdf_sun = sunDiskPDF();
                float mis_weight = powerHeuristic(pdf_bsdf, pdf_sun);
                vec3 brdf = hit.albedo * ONE_OVER_PI;
                radiance += throughput * brdf * L_sun * NdotL_bsdf / pdf_bsdf * mis_weight;
            }
            if (length(L_sun) == 0.0 && length(L_sky) > 0.0) {
                vec3 brdf = hit.albedo * ONE_OVER_PI;
                radiance += throughput * brdf * L_sky * NdotL_bsdf / pdf_bsdf;
            }
            break;
        }

        // ========== 间接光照 - 路径继续 ==========
        throughput *= hit.albedo * NdotL_bsdf / pdf_bsdf;

        // Russian Roulette
        float p_continue = min(max(throughput.x, max(throughput.y, throughput.z)), 0.95);
        if (random(seed + 300u) >= p_continue) {
            break;
        }
        throughput /= p_continue;

        origin = bsdf_hit.position + bsdf_hit.normal * EPSILON;
        direction = bsdf_dir;
    }

    return radiance;
}

// 从已知首次命中继续路径追踪（共用同一条 primary ray，不再打 primary）
// first_hit 为 primary ray 的命中结果；若未命中则只返回太阳或天空的贡献
// 按 bounce 划分：直接光 = 0 或 1 次 bounce（L E、L D E）；间接光 = 2+ bounce
void pathTraceFromHit(vec3 origin, vec3 direction, RayHit first_hit, uint pixel_seed, out vec3 direct_radiance, out vec3 indirect_radiance) {
    direct_radiance = vec3(0.0);
    indirect_radiance = vec3(0.0);

    if (!first_hit.hit) {
        vec3 L_sun = evaluateSunRadiance(direction);
        vec3 L_sky = evaluateSkyRadiance(direction);
        direct_radiance = L_sun + L_sky;  // 0 bounce：太阳/天空直接进相机 → direct
        return;
    }

    vec3 throughput = vec3(1.0);
    RayHit hit = first_hit;

    for (int depth = 0; depth < MAX_DEPTH; ++depth) {
        uint seed = pixel_seed + uint(depth) * 1000u;
        bool is_primary = (depth == 0);

        // ========== NEE（Next Event Estimation）- 光源采样 ==========
        vec2 u_sun = random2(seed + 100u);
        vec3 sun_dir = sampleSunDiskDirection(u_sun);
        float pdf_sun = sunDiskPDF();
        float NdotL_sun = max(dot(hit.normal, sun_dir), 0.0);

        if (NdotL_sun > 0.0 && pdf_sun > 0.0) {
            vec3 shadow_origin = hit.position + hit.normal * EPSILON;
            RayHit shadow_hit = traceRay(shadow_origin, sun_dir, EPSILON, 100000.0);

            bool sun_visible = !shadow_hit.hit;

            if (sun_visible) {
                vec3 L_sun = SUN_INTENSITY;
                float pdf_bsdf = cosineHemispherePDF(hit.normal, sun_dir);
                float mis_weight = powerHeuristic(pdf_sun, pdf_bsdf);

                vec3 brdf = hit.albedo * ONE_OVER_PI;
                vec3 contrib = throughput * brdf * L_sun * NdotL_sun / pdf_sun * mis_weight;
                if (is_primary) {
                    direct_radiance += contrib;
                } else {
                    indirect_radiance += contrib;
                }
            }
        }

        // ========== BSDF 采样 - 路径继续 ==========
        vec2 u_bsdf = random2(seed + 200u);
        vec3 bsdf_dir = sampleCosineHemisphere(u_bsdf, hit.normal);
        float pdf_bsdf = cosineHemispherePDF(hit.normal, bsdf_dir);
        float NdotL_bsdf = max(dot(hit.normal, bsdf_dir), 0.0);

        if (NdotL_bsdf <= 0.0 || pdf_bsdf <= 0.0) {
            break;
        }

        vec3 bsdf_origin = hit.position + hit.normal * EPSILON;
        RayHit bsdf_hit = traceRay(bsdf_origin, bsdf_dir, EPSILON, 100000.0);

        if (!bsdf_hit.hit) {
            vec3 L_sun = evaluateSunRadiance(bsdf_dir);
            vec3 L_sky = evaluateSkyRadiance(bsdf_dir);
            if (length(L_sun) > 0.0) {
                float pdf_sun = sunDiskPDF();
                float mis_weight = powerHeuristic(pdf_bsdf, pdf_sun);

                vec3 brdf = hit.albedo * ONE_OVER_PI;
                vec3 contrib = throughput * brdf * L_sun * NdotL_bsdf / pdf_bsdf * mis_weight;
                if (is_primary) {
                    direct_radiance += contrib;
                } else {
                    indirect_radiance += contrib;
                }
            }
            // 未命中几何且非太阳方向：视为击中天空；1 bounce → direct，2+ bounce → indirect
            if (length(L_sun) == 0.0 && length(L_sky) > 0.0) {
                vec3 brdf = hit.albedo * ONE_OVER_PI;
                vec3 contrib = throughput * brdf * L_sky * NdotL_bsdf / pdf_bsdf;
                if (is_primary) {
                    direct_radiance += contrib;
                } else {
                    indirect_radiance += contrib;
                }
            }
            break;
        }

        throughput *= hit.albedo * NdotL_bsdf / pdf_bsdf;

        float p_continue = min(max(throughput.x, max(throughput.y, throughput.z)), 0.95);
        if (random(seed + 300u) >= p_continue) {
            break;
        }
        throughput /= p_continue;

        hit = bsdf_hit;
    }
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 image_size = imageSize(output_image);
    ivec2 pixel_i = ivec2(pixel);
    if (pixel.x >= image_size.x || pixel.y >= image_size.y) {
        return;
    }

    uint iteration_hash = pcg_hash(pc.iteration);
    uint pixel_hash = pixel.y * image_size.x + pixel.x;
    uint base_pixel_seed = iteration_hash ^ (pixel_hash << 10u) ^ (pixel_hash >> 10u);

    Camera cam = cameras[pc.camera_index];
    mat4 inv_view = inverse(cam.view);
    mat4 inv_proj = inverse(cam.projection);

    // 使用 sample 0 的射线作为 primary（与 G-buffer 一致）；只 trace 一次，同时写 G-buffer 并作为 path 起点
    uint primary_seed = base_pixel_seed + 0u * 10000u;
    vec2 jitter = random2(primary_seed) - 0.5;
    vec2 uv = (vec2(pixel) + vec2(0.5) + jitter) / vec2(image_size);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 near_point = inv_proj * vec4(ndc, 0.0, 1.0);
    near_point /= near_point.w;
    vec4 far_point = inv_proj * vec4(ndc, 1.0, 1.0);
    far_point /= far_point.w;

    vec3 ray_origin_world = (inv_view * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec3 ray_dir_world = normalize((inv_view * far_point).xyz - (inv_view * near_point).xyz);

    RayHit first_hit = traceRay(ray_origin_world, ray_dir_world, EPSILON, 100000.0);

    // 写入 G-buffer（primary ray 命中结果）
    if (first_hit.hit) {
        imageStore(gbuffer_position_image, pixel_i, vec4(first_hit.position, 1.0));
        imageStore(gbuffer_normal_image, pixel_i, vec4(first_hit.normal, 1.0));
        imageStore(gbuffer_albedo_image, pixel_i, vec4(first_hit.albedo, 1.0));
        imageStore(gbuffer_depth_image, pixel_i, vec4(first_hit.t, 0.0, 0.0, 0.0));
    } else {
        // 未命中：写入无效标记（depth 大值表示 sky）
        imageStore(gbuffer_position_image, pixel_i, vec4(0.0, 0.0, 0.0, 0.0));
        imageStore(gbuffer_normal_image, pixel_i, vec4(0.0, 0.0, 0.0, 0.0));
        imageStore(gbuffer_albedo_image, pixel_i, vec4(0.0, 0.0, 0.0, 0.0));
        imageStore(gbuffer_depth_image, pixel_i, vec4(1e10, 0.0, 0.0, 0.0));
    }

    // 从同一 primary 命中继续 path tracing（多条路径样本，不同 seed）
    // 阶段 1：分别累加直接光与间接光
    vec3 direct_radiance = vec3(0.0);
    vec3 indirect_radiance = vec3(0.0);
    for (int s = 0; s < SAMPLES_PER_ITERATION; ++s) {
        uint sample_seed = base_pixel_seed + uint(s) * 10000u;
        vec3 d, i;
        pathTraceFromHit(ray_origin_world, ray_dir_world, first_hit, sample_seed, d, i);
        direct_radiance += d;
        indirect_radiance += i;
    }
    direct_radiance /= float(SAMPLES_PER_ITERATION);
    indirect_radiance /= float(SAMPLES_PER_ITERATION);

    // 写入直接光/间接光 HDR 图
    imageStore(direct_radiance_image, pixel_i, vec4(direct_radiance, 1.0));
    imageStore(indirect_radiance_image, pixel_i, vec4(indirect_radiance, 1.0));

    // ========== 合成：direct + indirect → tone map → output_image ==========
    vec3 current_radiance = direct_radiance + indirect_radiance;
    const float exposure = 2.0; // 曝光值：1.0 = 正常，2.0 = 一档亮，0.5 = 一档暗
    vec3 ldr_color = vec3(1.0) - exp(-current_radiance * exposure); // Reinhard tone mapping
    ldr_color = clamp(ldr_color, 0.0, 1.0);                        // 钳位到 [0,1]
    ldr_color = pow(ldr_color, vec3(1.0 / 2.2));                  // Gamma 校正 (sRGB)

    imageStore(output_image, ivec2(pixel), vec4(ldr_color, 1.0));
}
